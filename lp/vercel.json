{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(styles.css|script.js|vidro-liquido.js|consentimento.js|origem.js|lancamento.js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://www.legalizai.com.br" },
        { "key": "Vary", "value": "Origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "legalizei-lp.vercel.app" }],
      "destination": "https://www.legalizai.com.br/$1",
      "permanent": true
    },
    { "source": "/:path*", "has": [{ "type": "host", "value": "(app|baixar|download)[.]legalizai[.]com[.]br" }], "destination": "https://www.legalizai.com.br/baixar", "permanent": false },
    { "source": "/app-store", "destination": "https://apps.apple.com/br/app/id6830729265", "permanent": false },
    { "source": "/google-play", "destination": "https://play.google.com/store/apps/details?id=br.com.legalizai.app", "permanent": false },
    { "source": "/(baixar|app|download)", "has": [{ "type": "header", "key": "user-agent", "value": ".*(iPhone|iPad|iPod).*" }], "destination": "/app-store", "permanent": false },
    { "source": "/(baixar|app|download)", "has": [{ "type": "header", "key": "user-agent", "value": ".*Android.*" }], "destination": "/google-play", "permanent": false },
    { "source": "/(baixar|app|download)", "destination": "/#rodape", "permanent": false },
    { "source": "/(ios|iphone)", "destination": "/app-store", "permanent": false },
    { "source": "/android", "destination": "/google-play", "permanent": false },
    { "source": "/coming-soon/:path*", "destination": "/em-breve/:path*", "permanent": true },
    { "source": "/atendimento", "destination": "/", "permanent": false },
    { "source": "/blog/post", "destination": "/blog/fator-r", "statusCode": 301 },
    { "source": "/blog/post.html", "destination": "/blog/fator-r", "statusCode": 301 }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://cu2viedkfvwuiuauvvi4guzdnm0ktprm.lambda-url.sa-east-1.on.aws/api/v1/:path*"
    },
    { "source": "/home", "destination": "/" },
    { "source": "/em-breve/obrigado/mei", "destination": "/em-breve/obrigado" },
    { "source": "/em-breve/obrigado/me-simples", "destination": "/em-breve/obrigado" }
  ]
}
