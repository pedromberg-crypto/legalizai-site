{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(styles.css|script.js|vidro-liquido.js|consentimento.js|origem.js|lancamento.js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://www.legalizai.com.br" },
        { "key": "Vary", "value": "Origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/coming-soon/:path*", "destination": "/em-breve/:path*", "permanent": true },
    { "source": "/atendimento", "destination": "/", "permanent": false },
    { "source": "/blog/post", "destination": "/blog/fator-r", "statusCode": 301 },
    { "source": "/blog/post.html", "destination": "/blog/fator-r", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/home", "destination": "/" },
    { "source": "/em-breve/obrigado/mei", "destination": "/em-breve/obrigado" },
    { "source": "/em-breve/obrigado/me-simples", "destination": "/em-breve/obrigado" }
  ]
}
